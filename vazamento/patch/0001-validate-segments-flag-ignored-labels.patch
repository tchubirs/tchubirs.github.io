+def test_validate_segments_flags_labels_the_training_loader_would_ignore(
+    tmp_path: Path,
+) -> None:
+    # Mirrors the published PHerc1667 layout: the segment directory and its zarr
+    # carry a "_2um" suffix, but the v2 label TIFFs (including the validation
+    # mask) were written without it. discover_segment_labels() only accepts a
+    # label whose prefix equals the directory name, so it silently falls back to
+    # the v1 labels and drops the validation mask; the validator must say so
+    # instead of reporting the labels as present.
+    from vesuvius.ink_detection.data.segment import parse_label_asset_path
+
+    root = tmp_path / "labels"
+    seg = root / "1667" / "w028_2um"
+    ok = root / "1667" / "w029"
+    seg.mkdir(parents=True)
+    ok.mkdir(parents=True)
+    blank = np.zeros((16, 16), dtype=np.uint8)
+    for directory in (seg, ok):
+        _write_group(
+            directory / f"{directory.name}.zarr",
+            {"0": np.zeros((1, 16, 16), dtype=np.uint8)},
+            chunks=(1, 16, 16),
+        )
+    for kind in ("inklabels_v2", "supervision_mask_v2", "validation_mask_v2"):
+        tifffile.imwrite(seg / f"w028_{kind}.tif", blank)
+        tifffile.imwrite(ok / f"w029_{kind}.tif", blank)
+
+    # The training loader's own rule, applied to these names.
+    assert parse_label_asset_path(seg / "w028_validation_mask_v2.tif")["prefix"] != seg.name
+
+    results = validate_segments.validate_root(root, workers=1, show_progress=False)
+    issues = {
+        result.segment_dir.name: [issue.message for issue in result.issues]
+        for result in results
+    }
+    by_name = {result.segment_dir.name: result for result in results}
+    mismatched = {
+        issue.file_path.name
+        for issue in by_name["w028_2um"].issues
+        if "does not match segment directory" in issue.message
+    }
+    assert mismatched == {
+        "w028_inklabels_v2.tif",
+        "w028_supervision_mask_v2.tif",
+        "w028_validation_mask_v2.tif",
+    }
+    # With the ignored files discounted, the required labels are genuinely missing.
+    assert any("missing required label TIFF containing 'inklabels'" in m for m in issues["w028_2um"])
+    assert issues["w029"] == []
+    assert validate_segments.main([str(root), "--workers", "1", "--no-progress"]) == 1
+
+
