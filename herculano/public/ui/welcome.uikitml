<!--
  Guide panel: one line of instruction that follows what the player does.
  Panel, Divider, Button, ButtonIcon and ButtonLabel come from the bundled
  Horizon kit; RectangleGoggles, ScrollText and LogIn are bundled Lucide icons.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 380px;
  }

  .panel-content {
    flex-direction: column;
    padding-top: 16px;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 20px;
  }

  .heading {
    font-size: 22px;
    font-weight: 700;
    line-height: 28px;
    color: #272727;
  }

  .heading:dark {
    color: rgba(255, 255, 255, 0.92);
  }

  .hint {
    color: #272727;
    font-size: 16px;
    font-weight: 500;
    line-height: 22px;
    width: 100%;
    margin-top: 10px;
  }

  .hint:dark {
    color: rgba(255, 255, 255, 0.92);
  }

  .button {
    justify-content: flex-start;
    margin-left: 24px;
    margin-right: 24px;
    margin-bottom: 20px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div id="heading" class="heading">Herculaneum, AD 79</div>
    <Divider></Divider>
    <div id="hint" class="hint">
      A scroll buried by Vesuvius, burnt to carbon. Pinch it and pull it to the right to open it.
    </div>
  </div>
  <Button id="xr-button" class="button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label">Enter XR</ButtonLabel>
  </Button>
  <Button id="next-button" class="button" style="display: none">
    <ButtonIcon>
      <ScrollText></ScrollText>
    </ButtonIcon>
    <ButtonLabel class="button-label">Open another scroll</ButtonLabel>
  </Button>
  <Button id="exit-button" class="button" style="display: none">
    <ButtonIcon>
      <LogIn></LogIn>
    </ButtonIcon>
    <ButtonLabel class="button-label">Exit to Browser</ButtonLabel>
  </Button>
</Panel>
