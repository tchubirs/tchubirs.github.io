# ─────────────────────────────────────────────────────────────
# Copie para .env e preencha. NUNCA faça commit do .env.
# No GitHub Actions, cadastre cada uma como Secret do repositório.
# ─────────────────────────────────────────────────────────────

# 1) Claude — seleção de momentos e redação de títulos/descrições
ANTHROPIC_API_KEY=

# 2) YouTube Data API v3 (publicação automática de Shorts)
#    Gere com: python tools/youtube_oauth.py
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# 3) Instagram Reels via Graph API (opcional — precisa de conta Business + Página FB)
IG_USER_ID=
IG_ACCESS_TOKEN=

# 4) Hospedagem pública do MP4 para o Instagram (a Graph API exige URL pública).
#    Usamos GitHub Releases como CDN gratuito. O token precisa de escopo `repo`.
GITHUB_TOKEN=
GITHUB_REPO=tchubirs/tchubirs.github.io
