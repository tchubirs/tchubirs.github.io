# Segredos
.kick-secret
.kick-token.json
*.secret

# Dependências: `npm install` recria. Commitar o Playwright seriam centenas
# de MB no repositório e um navegador desatualizado para quem clonar.
node_modules/

# Estado local da máquina de quem roda
detetive.db
detetive.db-wal
detetive.db-shm
detetive.config.json
demo.html

# As leituras são de quem roda — cada máquina grava a sua live.
dados/leituras.jsonl
dados/presenca.jsonl

# Histórico de nomes lido das páginas: são dados de PESSOAS REAIS, com nome,
# ano e SteamID. Isso não entra num repositório público — o produto ajuda a
# investigar uma live, não a publicar um dossiê de quem passou por ela.
dados/nomes-*.json
